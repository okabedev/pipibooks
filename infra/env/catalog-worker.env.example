# 복사: cp infra/env/catalog-worker.env.example infra/env/catalog-worker.env
# DB_PASSWORD는 postgres.env의 CATALOG_APP_PASSWORD 와 같은 값으로 채운다.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pipibooks
DB_USER=catalog_app
DB_PASSWORD=
# 국립중앙도서관 ISBN 서지정보 API 인증키. 비어 있어도 기동하지만 수집 실행은 FAILED로 남는다.
NLK_CERT_KEY=
# Healthchecks.io 수집 하트비트 URL(선택). 비어 있으면 보내지 않는다.
HEALTHCHECK_COLLECT_URL=
